[background]
# Filled in by bootstrap.sh: whatever /etc/greetd/wallpaper.* already exists
# (set via Super+Shift+G -> set-greeter-wallpaper) is preserved; only a truly
# fresh install with nothing there yet falls back to the tracked default.
path = "{{WALLPAPER_PATH}}"
fit = "Cover"

[GTK]
application_prefer_dark_theme = true
cursor_theme_name = "Bibata-Modern-Ice"
font_name = "JetBrainsMono Nerd Font 11"
icon_theme_name = "Adwaita"
theme_name = "Adwaita"

[commands]
reboot = ["systemctl", "reboot"]
poweroff = ["systemctl", "poweroff"]

[appearance]
greeting_msg = "Welcome back"
