/* Generated by theming/apply-theme.py — don't hand-edit, edit the
 * palette TOML instead and re-run apply-theme.py. */

@define-color main-bg {{bg}};
@define-color main-fg {{fg}};

@define-color wb-hvr-bg {{hover-bg}};
@define-color wb-hvr-fg {{hover-fg}};

@define-color danger {{danger}};

/* Cluster-pill tints for user-style.css — derived from fg/accent at fixed
 * alphas so every preset gets consistent, proportionate tinting without a
 * separate stored token per cluster. */
@define-color tray-tint rgba({{fg-rgb}}, 0.05);
@define-color net-tint rgba({{accent-rgb}}, 0.15);
@define-color sys-tint rgba({{fg-rgb}}, 0.1);
