/* Generated by theming/apply-theme.py — don't hand-edit, edit the
 * palette TOML instead and re-run apply-theme.py.
 *
 * */
@define-color text-color {{fg}};
/* was a hardcoded near-black -- invisible against a dark palette's bg;
 * self-adapts to any palette by dimming the real text color instead. */
@define-color text-color-disabled alpha({{fg}}, 0.5);

/*
 *
 * control center
 *
 * */
/* background */
@define-color sw-cc-bg {{bg}};
/* border */
@define-color sw-cc-border-color {{accent}};

.control-center {
  /* The Control Center which contains the old notifications + widgets */
  background: @sw-cc-bg;
  color: @text-color;
  border-radius: 0px;
  border: 2px solid @sw-cc-border-color;
  opacity: 0.9;
}


/*
*
* notification window
*
* */
/* background */
@define-color sw-noti-window-bg {{bg}};
/* border */
@define-color sw-noti-window-br {{accent}};
/* color */
@define-color sw-noti-window-txt {{fg}};
/* hover */
@define-color sw-noti-bg-hover {{bg-alt}};

@define-color noti-bg-hover @sw-noti-bg-hover;

.notification-row .notification-background {
  padding: 14px;
}

.notification-row .notification-background .notification {
  /* The actual notification */
  color: @sw-noti-window-txt;
  border-radius: 0px;
  border: 2px solid @sw-noti-window-br;
  padding: 5px;
  transition: background 0.15s ease-in-out;
  background: @sw-noti-window-bg;
  opacity: 0.8;
}


/*
*
* summary message
*
* */
/* foreground */
@define-color sw-msg-sum-fg {{fg}};
/* body */
@define-color sw-msg-body {{fg}};


.notification-row .notification-background .notification .notification-default-action .notification-content .text-box .summary {
  /* Notification summary/title */
  font-size: 16px;
  font-weight: bold;
  background: transparent;
  color: @text-color;
  text-shadow: none;
}

.notification-row .notification-background .notification .notification-default-action .notification-content .text-box .body {
  /* Notification body text -- previously unstyled, fell through to GTK's
   * default (light-theme-independent) text color. Invisible against a light
   * palette's background; happened to still be legible against a dark one,
   * which is why this went unnoticed until the first light theme. */
  background: transparent;
  color: @sw-msg-body;
  text-shadow: none;
}

/*
*
* notification group
*
* */
/* icon */
@define-color sw-noti-gr-icon {{fg}};
/* button */
@define-color sw-noti-gr-collapse-but-hvr {{hover-bg}};
/* icon */
@define-color sw-noti-gr-collapse-but-icon {{fg}};

.notification-group .notification-group-headers .notification-group-icon {
  color: @sw-noti-gr-icon;
}

.notification-group.collapsed .notification-group-headers .notification-group-icon {
  color: @sw-noti-gr-collapse-but-icon;
}
.notification-group.collapsed .notification-row .notification {
  background-color: @sw-noti-window-bg;
}
.notification-group.collapsed:hover .notification-row:not(:only-child) .notification {
  background-color: @sw-noti-gr-collapse-but-hvr;
}
