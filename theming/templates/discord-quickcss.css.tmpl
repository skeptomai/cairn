/* Generated by cachyos/theming/apply-theme.py — don't hand-edit, edit the
 * palette TOML instead and re-run apply-theme.py.
 *
 * Vesktop (Vencord) ships with no system-theme integration of its own, so
 * this retints it via the same mechanism pywal/wallust Discord integrations
 * use: import a BetterDiscord recolor theme that exposes the whole UI as
 * CSS custom properties, then override those properties from this preset's
 * palette instead of the theme's own hardcoded defaults. Vencord watches
 * this file and hot-reloads it live -- no app restart needed. */

@import url('https://mwittrien.github.io/BetterDiscordAddons/Themes/DiscordRecolor/DiscordRecolor.css');

:root {
  --accentcolor: {{accent-rgb}};
  --accentcolor2: {{bg-alt-rgb}};
  --linkcolor: {{accent-rgb}};
  --mentioncolor: {{accent-rgb}};
  --textbrightest: {{fg-rgb}};
  --textbrighter: {{fg-rgb}};
  --textbright: {{fg-rgb}};
  --textdark: {{fg-rgb}};
  --textdarker: {{fg-inactive-rgb}};
  --textdarkest: {{bg-rgb}};

  --backgroundaccent: {{bg-alt-rgb}};
  --backgroundprimary: {{bg-rgb}};
  --backgroundsecondary: {{bg-alt-rgb}};
  --backgroundsecondaryalt: {{bg-alt-rgb}};
  --backgroundtertiary: {{bg-alt-rgb}};
  --backgroundfloating: {{bg-alt-rgb}};
  --settingsicons: 0;
}

::-webkit-scrollbar {
  width: 10px !important;
}

::-webkit-scrollbar-thumb {
  /* On bigger screens, the scrollbar's border radius falls short, so we
  put an obscenely large value for the border radius */
  border-radius: 500px !important;
  background: rgba({{accent-rgb}}, 0.7) !important;
  background-clip: content-box !important;
  border: 2px solid transparent !important; /* Margin for the scrollbar */
}

