# Generated by theming/apply-theme.py — don't hand-edit, edit the
# palette TOML instead and re-run apply-theme.py.

# Main bg
theme[main_bg]="{{bg}}"

# Main text color
theme[main_fg]="{{fg}}"

# Title color for boxes
theme[title]="{{fg}}"

# Highlight color for keyboard shortcuts
theme[hi_fg]="{{accent}}"

# Background color of selected item in processes box
theme[selected_bg]="{{hover-bg}}"

# Foreground color of selected item in processes box
theme[selected_fg]="{{hover-fg}}"

# Color of inactive/disabled text
theme[inactive_fg]="{{bright-black}}"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="{{accent}}"

# Cpu box outline color
theme[cpu_box]="{{bg-alt}}"

# Memory/disks box outline color
theme[mem_box]="{{bg-alt}}"

# Net up/down box outline color
theme[net_box]="{{bg-alt}}"

# Processes box outline color
theme[proc_box]="{{bg-alt}}"

# Box divider line and small boxes line color
theme[div_line]="{{bg-alt}}"

# Temperature graph colors
theme[temp_start]="{{green}}"
theme[temp_mid]="{{yellow}}"
theme[temp_end]="{{danger}}"

# CPU graph colors
theme[cpu_start]="{{blue}}"
theme[cpu_mid]="{{magenta}}"
theme[cpu_end]="{{danger}}"

# Mem/Disk free meter
theme[free_start]="{{green}}"
theme[free_mid]="{{yellow}}"
theme[free_end]="{{danger}}"

# Mem/Disk cached meter
theme[cached_start]="{{cyan}}"
theme[cached_mid]="{{blue}}"
theme[cached_end]="{{magenta}}"

# Mem/Disk available meter
theme[available_start]="{{green}}"
theme[available_mid]="{{yellow}}"
theme[available_end]="{{danger}}"

# Mem/Disk used meter
theme[used_start]="{{blue}}"
theme[used_mid]="{{magenta}}"
theme[used_end]="{{danger}}"

# Download graph colors
theme[download_start]="{{green}}"
theme[download_mid]="{{yellow}}"
theme[download_end]="{{danger}}"

# Upload graph colors
theme[upload_start]="{{cyan}}"
theme[upload_mid]="{{blue}}"
theme[upload_end]="{{magenta}}"
