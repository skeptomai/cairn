// waybar config for the Sway session — separate from the Hyprland/HyDE
// config.jsonc so that setup is left untouched. Reuses the same
// style.css/theme.css (waybar loads style.css from this directory by
// default regardless of which -c config is passed).
{
    "layer": "top",
    "position": "top",
    "height": 46,
    "exclusive": true,
    "reload_style_on_change": true,

    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-center": ["sway/window"],
    "modules-right": [
        "group/tray-cluster",
        "custom/separator",
        "group/net-cluster",
        "custom/separator",
        "group/sys-cluster",
        "custom/separator",
        "clock"
    ],

    "group/tray-cluster": {
        "orientation": "horizontal",
        "modules": ["custom/notification", "idle_inhibitor", "tray", "custom/power"]
    },

    "group/net-cluster": {
        "orientation": "horizontal",
        "modules": ["network", "pulseaudio", "backlight"]
    },

    "group/sys-cluster": {
        "orientation": "horizontal",
        "modules": ["cpu", "memory", "battery"]
    },

    "sway/workspaces": {
        "all-outputs": true,
        "disable-scroll": false,
        "disable-click": false,
        "format": "{name}",
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": []
        },
        "format-icons": {
            "default": "",
            "focused": ""
        }
    },

    "sway/mode": {
        "format": "  {}"
    },

    "sway/window": {
        "max-length": 60,
        "tooltip": false
    },

    "custom/notification": {
        "tooltip": false,
        "format": "",
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": { "activated": "", "deactivated": "" },
        "tooltip-format-activated": "Idle inhibitor: ON (screen won't auto-lock/sleep)",
        "tooltip-format-deactivated": "Idle inhibitor: off (normal auto-lock/sleep)"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8,
        "tooltip": true
    },

    "custom/separator": {
        "format": "│",
        "tooltip": false
    },

    "custom/power": {
        "format": "",
        "tooltip-format": "Power menu (suspend/logout/shutdown/reboot)",
        "on-click": "wlogout"
    },

    "network": {
        "format-wifi": "  {essid} ({signalStrength}%)",
        "format-ethernet": "  {ipaddr}",
        "format-disconnected": "󰤮 disconnected",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}\nSignal: {signalStrength}%",
        "on-click": "ghostty -e nmtui"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": " muted",
        "tooltip-format": "{desc}\nVolume: {volume}%",
        "format-icons": { "default": ["", "", ""] },
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-scroll-up": "swayosd-client --output-volume raise",
        "on-scroll-down": "swayosd-client --output-volume lower"
    },

    "backlight": {
        "format": "{icon}  {percent}%",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "Brightness: {percent}%",
        "on-scroll-up": "swayosd-client --brightness raise",
        "on-scroll-down": "swayosd-client --brightness lower"
    },

    "cpu": {
        "format": "  {usage}%",
        "tooltip-format": "CPU usage: {usage}%",
        "on-click": "ghostty -e btop",
        "interval": 5
    },

    "memory": {
        "format": "  {percentage}%",
        "tooltip-format": "RAM: {used:0.1f}GiB / {total:0.1f}GiB ({percentage}%)",
        "on-click": "ghostty -e btop",
        "interval": 5
    },

    "battery": {
        "format": "{icon}",
        "format-charging": "",
        "tooltip-format": "Battery: {capacity}%\nTime remaining: {time}",
        "format-icons": ["", "", "", "", ""],
        "states": { "warning": 30, "critical": 15 }
    },

    "clock": {
        "format": "  {:%a %d %b  %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    }
}
